#!/bin/rc -e
rfork ne
path=(/$cputype/bin /rc/bin)
. $nix9AccessSystem/services/access-config
fn fail {
  echo 'nix9: access configuration failed:' $* >[1=2]
  exit 'access configuration failed'
}
fn privateFile {
  test -f $1 && test -r $1 || fail 'private runtime file is unavailable:' $1
  ls -ld $1 | grep -s $2 || fail 'runtime file has unsafe permissions:' $1
}
if(~ $nix9AuthEnabled 1) {
  privateFile $nix9AuthDatabase '^-[-l]r[-w]-[-r][-w]---- '
  test -f /lib/ndb/auth || fail 'native authentication policy mount point is missing'
  if(! ~ $#nix9AuthUsers 0) {
    $nix9AuthPackage/bin/auth/keyfs -r -m /mnt/keys $nix9AuthDatabase </dev/null || fail 'cannot inspect authentication database'
    $nix9AuthPackage/bin/auth/checkuser /mnt/keys $nix9AuthUsers || fail 'required authentication identities are not provisioned'
  }
}
if(~ $nix9FactotumRequired 1) {
  test -r /mnt/factotum/ctl && test -w /mnt/factotum/ctl || fail 'boot factotum is unavailable'
  for(key in $nix9AccessKeys) privateFile $key '^-[-l]r[-w]------- '
}
for(root in $nix9ExportRoots) {
  if(! test -d $root) {
    if(! ~ $#* 1 || ! ~ $1 --planned-directories || ! ~ $root $nix9PlannedDirectories)
      fail 'export directory is unavailable:' $root
  }
}
exit ''

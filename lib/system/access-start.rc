# Run in the listener's private namespace, before accepting connections.
. $nix9ListenStartSystem/services/access-config
/$cputype/bin/rc $nix9ListenStartSystem/services/access-check || exit 'access configuration failed'
if(! ~ $#nix9MachineId 1) exit 'missing machine identity'
nix9AccessLock='#s/nix9-access-'^$nix9MachineId
# Services and their policy remain tied to the booted generation.
if(test -e $nix9AccessLock) exit ''
@{ status='' } > $nix9AccessLock || exit 'access startup is locked'
fn sigexit { result=$status; rm $nix9AccessLock; status=$result }
for(key in $nix9AccessKeys) {
  @{
    rfork e
    ifs='
'
    while(command=`{read}) {
      if(~ $#command 1) {
        echo $command > /mnt/factotum/ctl || exit 'cannot load service key'
      }
    }
    exit ''
  } < $key || exit 'cannot load service keys'
}
if(~ $nix9AuthEnabled 1) {
  $nix9AuthPackage/bin/auth/keyfs -m /mnt/keys $nix9AuthDatabase </dev/null || exit 'cannot mount authentication database'
  bind $nix9ListenStartSystem/services/auth-policy /lib/ndb/auth || exit 'cannot bind authentication policy'
  trust=($nix9ListenStartSystem/services/auth)
}

# nix9 CPU hook
if(test -r /rc/bin/cpurc.local.nix9-original) . /rc/bin/cpurc.local.nix9-original
. /usr/local/pkg/nix9/activate && {
 if(~ $#nix9SystemRoot 1 && test -r $nix9SystemRoot) {
  nix9BootSystem=`{cat $nix9SystemRoot}
  if(. $nix9BootSystem/boot) {
    # cpurc always passes -n and does not use TIMESYNCARGS. Start the selected
    # source here; its later native process check prevents a second client.
    if(test -f $nix9BootSystem/services/timesync.rc) @{
      rfork e
      path=(/$cputype/bin /rc/bin)
      . $nix9BootSystem/services/timesync.rc && {
        if(! ps | grep -s timesync) aux/timesync $TIMESYNCARGS
      }
    }
  }
  nix9BootSystem=()
 }
}
status=''

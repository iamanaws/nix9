# newns rebuilt /bin and /mnt, but retained the boot environment. Discard its
# activation markers before creating this connection's private generation view.
path=(/$cputype/bin /rc/bin)
fn webfs
nix9System=()
nix9EnvironmentActive=()
nix9EnvironmentPaths=()
nix9EnvironmentFileTargets=()
nix9EnvironmentFileRoot=()
nix9BasePath=()
nix9BasePATH=()
nix9WebfsSystem=()
nix9WebfsRuntime=()
nix9WebfsId=()
nix9WebfsStop=()
nix9SystemCheck=()
if(! ~ $#nix9ListenRuntime 1) exit 'missing TCP service runtime'
. $nix9ListenRuntime/activate
nix9NextSystem=$nix9ListenConnectionSystem
# Background services must not retain the connection's input or output.
. $nix9NextSystem/activate < /dev/null > /dev/null
. $nix9System/services/listen-scripts/$1 $*

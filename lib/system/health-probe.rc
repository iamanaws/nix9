# A probe owns its namespace; fresh mounts disappear on success or timeout.
rfork ne
healthSystem=$1
point=$2
operation=$3
shift 3
. $healthSystem/health-config
switch($operation) {
case listener
  netstat -n -p tcp | awk -v 'port='^$1 '$1 == "tcp" && $4 == "Listen" && $5 == port {found=1} END {exit !found}' || {
    echo 'no TCP listener on port' $1 >[1=2]
    exit 'listener unavailable'
  }
case directory writable-directory
  test -d $1
  if(~ $operation writable-directory) {
    temporary=$1^'/.nix9-health-'^$pid
    if(! echo -n '' > $temporary) {
      echo 'directory is not writable:' $1 >[1=2]
      exit 'directory is not writable'
    }
    rm $temporary
  }
  ls -d $1 > /dev/null
case udp-listener
  found=0
  for(connection in /net/udp/[0-9]*)
    if(test -f $connection/local && ~ `{cat $connection/local} ::!^$1 0.0.0.0!^$1) {
      current=`{cat $connection/status}
      if(~ $current(1) Open) found=1
    }
  if(~ $found 0) {
    echo 'no UDP listener on port' $1 >[1=2]
    exit 'listener unavailable'
  }
  status=''
case dns-listener
  protocol=$1
  expected=$2^'!53'
  if(test $2 '=' '*') expected=(::!53 0.0.0.0!53)
  state=Listen
  if(~ $protocol udp) state=Open
  found=0
  for(connection in /net/$protocol/[0-9]*)
    if(test -f $connection/local && ~ `{cat $connection/local} $expected) {
      current=`{cat $connection/status}
      if(~ $current(1) $state) found=1
    }
  if(~ $found 0) {
    echo 'no DNS' $protocol 'listener on' $2 >[1=2]
    exit 'DNS listener unavailable'
  }
  status=''
case ndb
  host=$1
  answer=`{$healthNdb /net/cs tcp!^$1^!9}
  shift
  for(address in $*) {
    echo $answer | awk -v 'expected='^$address^'!9' '{for(i=1;i<=NF;i++) if($i == expected) found=1} END {exit !found}' || {
      echo 'cs lookup for' $host 'expected' $address 'but returned:' $answer >[1=2]
      exit 'discovery differs'
    }
  }
case mount
  switch($1) {
  case tls
    $healthClient -a -k $3 $2 $healthMount -nc /fd/0 $point
  case tcp
    $healthDial $2 $healthMount -c -k $3 /fd/0 $point $4
  case *
    exit 'invalid health transport'
  }
  ls -d $point > /dev/null
  shift 4
  for(relative in $*) ls -d $point^$relative > /dev/null
case *
  exit 'invalid health probe'
}

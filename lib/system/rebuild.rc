#!/bin/rc -e
fn usage {
  echo 'Usage: nix9-rebuild ACTION [ARGUMENT]

  build [CONFIGURATION]   Build and retain a system without selecting it.
  switch [CONFIGURATION]  Build, check and select a system.
  status                  Show selected, booted and session systems.
  rollback                Select the preceding generation.
  list                    List retained generations.
  delete NUMBER           Release an inactive generation for garbage collection.

CONFIGURATION defaults to ./configuration.nix.
Use nix9 init, check and select for local provisioning and prebuilt systems.
Refresh after selection with: . /usr/local/pkg/nix9/system'
}
if(~ $#* 1 && ~ $1 help -h --help) {
  usage
  exit ''
}
if(~ $#* 0) {
  usage >[1=2]
  exit usage
}
if(! ~ $1 build switch status rollback list delete) {
  echo 'nix9-rebuild: unknown action:' $1 '; see nix9-rebuild help' >[1=2]
  exit usage
}
if(! ~ $#nix9 1) {
  echo 'nix9-rebuild: activate a nix9 installation first' >[1=2]
  exit 'nix9 is not active'
}
exec /$cputype/bin/rc -e $nix9/packages/system/manage.rc nix9-rebuild $*

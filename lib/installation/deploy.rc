#!/bin/rc -e
rfork ne

fn fail {
  echo nix9: $* >[1=2]
  exit 'nix9 failed'
}
# Internal coordinator; the public interface validates source and target scope.
if(test $#* -lt 2) fail 'invalid coordinator request'
action=$1
bundle=$2
shift 2
if(! ~ $action show prepare select apply select-root status) fail 'unknown coordinator action:' $action
if(! ~ $#nix9 1) fail 'activate a nix9 installation first'
path=($nix9/bin /$cputype/bin /rc/bin)
. $nix9/packages/system/machine.rc || fail 'machine setup failed'
. $nix9/packages/system/output.rc
bundle=`{resolveOutput installation $bundle}
if(! ~ $#bundle 1) exit 'nix9 failed'
nix-store --check-validity $bundle || fail 'installation is not registered locally'
if(! test -f $bundle/deployment.rc) fail 'installation has no deployment configuration'
. $bundle/deployment.rc
requested=$*
if(~ $#requested 0) {
  requested=$machineNames
  if(~ $action select-root) requested=$bootMachineNames
}
for(name in $requested)
  if(! ~ $name $machineNames) fail 'unknown machine:' $name
if(~ $action select-root) {
  if(~ $#requested 0) fail 'no network-root CPUs requested'
  for(name in $requested)
    if(! ~ $name $bootMachineNames) fail 'not a network-root CPU:' $name
}
if(~ $action show) {
  if(! test -f $bundle/overview-header) fail 'installation has no overview; rebuild the bundle'
  cat $bundle/overview-header
  for(name in $requested) cat $bundle/overview/$name
  exit ''
}

# Serialize this installation on the coordinator. Target operations also lock
# independently, so different coordinators cannot import/select simultaneously.
lock='#s/nix9-deploy-client-'^$installationName
@{ status='' } > $lock || fail 'deployment is locked:' $lock
work=/usr/local/nix/state/deploy-^$installationName^-^$pid
clientRoot=/usr/local/nix/state/gcroots/deployments/.clients/^$installationName^-^$pid
workOwned=0
retained=0
fn sigexit {
  result=$status
  if(~ $workOwned 1 && test -d $work) rm -r $work
  if(~ $retained 1 && test -f $clientRoot) rm $clientRoot
  rm $lock
  status=$result
}
if(test -e $work) fail 'temporary directory already exists:' $work
if(test -e $clientRoot) fail 'temporary root already exists:' $clientRoot
mkdir $work
workOwned=1
chmod 700 $work
mkdir -p /usr/local/nix/state/gcroots/deployments/.clients
retained=1
nix-store --option substitute false --realise $bundle --add-root $clientRoot > /dev/null ||
  fail 'cannot retain the installation'
helper=$nix9/packages/installation/target.rc

# Native rc keeps -e inside functions called by if/||. Preserve child failures
# here so callers can report them or continue querying other machines.
fn target {
  operation=$1
  targetObject=$system
  if(~ $#* 2) targetObject=$2
  cat $bundle/deployment/$name.rc > $work/request.rc || fail 'cannot stage target request'
  if(~ $#nix9MachineId 1 && ~ $nix9MachineId $identity) {
    /$cputype/bin/rc -e $helper $operation $installationName $name $identity $targetObject $work || status=$status
  }
  if not {
    if(~ $remote 0) {
      echo nix9: $name 'needs local deployment; run this command on that machine' >[1=2]
      status='local deployment required'
    }
    if not {
      login=()
      if(~ $#loginUser 1) login=(-u $loginUser)
      alarm $timeout $cpuClient -h $host $login -k $keyPattern -c \
        /bin/rc -e /mnt/term^$helper $operation $installationName $name $identity $targetObject /mnt/term^$work || status=$status
    }
  }
}

fn transfer {
  transferObject=$1
  transferAction=$2
  closure=`{nix-store --query --requisites $transferObject && echo nix9-closure-ready}
  if(~ $#closure 0 || ! ~ $closure($#closure) nix9-closure-ready)
    fail 'cannot query the local closure for' $name
  {
    for(item in $closure) {
      if(! ~ $item nix9-closure-ready) echo $item
    }
  } > $work/paths
  probe=`{target missing $transferObject && echo nix9-probe-ready}
  if(~ $#probe 0 || ! ~ $probe($#probe) nix9-probe-ready)
    fail 'cannot inspect' $name
  missing=`{echo $probe | awk '{for(i=1;i<NF;i++) print $i}'}
  for(item in $missing)
    if(! ~ $item $closure) fail 'unexpected missing path from' $name
  if(! ~ $#missing 0) {
    echo Exporting $#missing paths for $name
    nix-store --export $missing > $work/closure.export || fail 'export failed for' $name
  }
  if not if(test -f $work/closure.export) rm $work/closure.export
  target $transferAction $transferObject || fail 'preparation failed for' $name
}

fn preparationTargets {
  preparing=$requested
  expanded=1
  while(~ $expanded 1) {
    expanded=0
    for(name in $preparing) {
      machine $name
      for(provider in $jobTargets) {
        if(! ~ $provider $preparing) {
          echo Preparing required job target $provider
          preparing=($preparing $provider)
          expanded=1
        }
      }
    }
  }
  status=''
}
fn deploymentStatus {
  failed=0
  for(name in $requested) {
    machine $name
    echo $name intended $system
    if(~ $#bootArtifact 1) {
      echo $name root-intended $rootDirectory
      echo $name root-provider $rootProvider
    }
    if(! target status) {
      echo $name unavailable >[1=2]
      failed=1
    }
  }
  if(~ $failed 1) fail 'some machines could not be queried'
  status=''
}
fn prepareSystems {
  preparationTargets
  published=()
  for(consumer in $preparing) {
    machine $consumer
    if(~ $#bootArtifact 1) {
      provider=$rootProvider
      artifact=$rootBundle
      publication=$provider^':'^$artifact
      if(! ~ $publication $published) {
        name=$provider
        machine $name
        echo Publishing root on $name
        transfer $artifact prepare-root
        published=($published $publication)
      }
    }
  }
  for(name in $preparing) {
    machine $name
    echo Preparing $name
    transfer $system prepare
    if(~ $#bootArtifact 1) transfer $bootArtifact prepare-boot
    echo $name prepared $system
  }
}
fn selectSystems {
  # Check every requested machine and every remote job target before changing
  # any selection. Runtime session mounts may be cyclic and impose no boot order.
  checking=$requested
  for(name in $requested) {
    machine $name
    for(provider in $jobTargets)
      if(! ~ $provider $checking) checking=($checking $provider)
  }
  for(name in $checking) {
    machine $name
    target ready || fail 'prepare the intended system on' $name 'before selecting'
  }
  for(name in $requested) {
    machine $name
    target select || fail 'selection stopped at' $name '; use status before retrying'
    echo $name selected $system
  }
}
fn selectedSummary {
  for(name in $requested) {
    machine $name
    if(target status > $work/status) {
      echo -n $name^' '
      awk '$2 == "selected" {selected=$3} $2 == "reboot" {reboot=$3}
        END {print "selected " selected "; reboot " reboot}' $work/status
    }
    if not fail 'selected systems; cannot query status on' $name
  }
}
switch($action) {
case status
  deploymentStatus
case prepare
  prepareSystems
case select
  selectSystems
case apply
  prepareSystems
  selectSystems
  selectedSummary
case select-root
  for(name in $requested) {
    machine $name
    target root-ready || fail 'root preflight failed for' $name
  }
  for(name in $requested) {
    machine $name
    target select-root || fail 'root selection stopped at' $name '; use status before retrying'
    echo $name root-selected $rootDirectory
  }
}
exit ''

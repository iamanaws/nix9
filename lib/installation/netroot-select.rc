#!/bin/rc
rfork ne
fn fail {
  echo 'nix9: select root:' $* >[1=2]
  exit 'root selection failed'
}
if(! ~ $#* 2) fail 'usage: select ROOT-MOUNT BOOT-MEDIUM-MOUNT'
bundle=`{basename -d $0}
rootMount=$1
medium=$2
. $bundle/check-select.rc || fail 'root selection preflight failed'
mkdir $medium/nix9lock || fail 'boot medium is locked'
fn sigexit {
  rm $medium/nix9lock
}
awk 'NR==FNR { split($0, a, "="); keys[a[1]]=1; next }
     { split($0, a, "="); if(!(a[1] in keys)) print }' $bundle/plan9.ini $ini > $medium/plan9.new || fail 'cannot stage boot settings'
cat $bundle/plan9.ini >> $medium/plan9.new || fail 'cannot append boot settings'
if(cmp -s $medium/plan9.new $ini) {
  rm $medium/plan9.new
  echo 'Root already selected for next boot:' $rootDirectory
  exit ''
}
cp $ini $medium/plan9.bak || fail 'cannot save previous boot settings'
if(! mv $medium/plan9.new $ini) {
  cp $medium/plan9.bak $ini
  fail 'cannot select root; previous settings are in plan9.bak'
}
echo 'Selected root for next boot:' $rootDirectory
echo 'Previous boot settings:' $medium/plan9.bak

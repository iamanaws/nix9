#!/bin/rc
rfork ne
fn fail {
  echo 'nix9: prepare network root:' $* >[1=2]
  exit 'network root preparation failed'
}
if(! ~ $#* 2) fail 'usage: prepare ROOT-MOUNT BOOTSTRAP-TAR'
bundle=`{basename -d $0}
. $bundle/configuration.rc || fail 'cannot read boot configuration'
base=$1^$rootDirectory
node=$1^$stateDirectory
test -r $2 || fail 'cannot read bootstrap archive'
for(file in amd64/init amd64/bin/rc lib/namespace)
  test -f $base/$file || fail 'incomplete 9front root:' $file
grep -s '^\. /lib/namespace.local$' $base/lib/namespace || fail 'root namespace must include /lib/namespace.local'
if(test -e $node) fail 'machine state already exists:' $node
bootDirectory=$base/cfg/nix9/boot/$machineId
for(file in namespace init)
  if(test -e $bootDirectory/$file) fail 'boot file already exists:' $file
mkdir -p $node || fail 'cannot create machine directory'
chmod 755 $node || fail 'cannot set machine directory permissions'
@{ cd $node && tar x } < $2 || fail 'cannot unpack bootstrap'
for(directory in rc/bin rc/lib adm service sys/log tmp usr/local/nix/store usr/local/nix/state usr/local/nix/log)
  mkdir -p $node/$directory || fail 'cannot create machine directory:' $directory
chmod 700 $node/adm || fail 'cannot protect runtime keys'
for(hook in rc/bin/cpurc.local rc/bin/termrc.local rc/lib/rcmain.local) {
  for(file in $hook $hook^.nix9-original) {
    if(test -f $base/$file)
      cp $base/$file $node/$file || fail 'cannot copy startup hook:' $file
  }
}
# Initialize through the normal command, in a namespace using only this node's state.
@{
  rfork ne
  nix9local=()
  nix9machine=$machineId
  bind -c $node/usr/local/nix /usr/local/nix &&
  bind -c $node/usr/local/pkg /usr/local/pkg &&
  . /usr/local/pkg/nix9/activate &&
  nix9-rebuild init $machineId
} || fail 'cannot initialize machine identity'
mkdir -p $bootDirectory $base/cfg/default/service || fail 'cannot create boot directories'
cp $bundle/namespace $bootDirectory/namespace &&
cp $bundle/init $bootDirectory/init &&
chmod 755 $bootDirectory/init || fail 'cannot install boot files'
if(! test -f $base/lib/namespace.local ||
   ! grep -s '^\. /cfg/nix9/boot/\$nix9machine/namespace$' $base/lib/namespace.local) {
  { echo; echo '. /cfg/nix9/boot/$nix9machine/namespace' } >> $base/lib/namespace.local || fail 'cannot install root namespace include'
}
echo 'Prepared network-root machine:' $machineId

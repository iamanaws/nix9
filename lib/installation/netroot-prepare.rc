#!/bin/rc
rfork ne
fn fail {
  echo 'nix9: prepare network root:' $* >[1=2]
  exit 'network root preparation failed'
}
if(! ~ $#* 2 3) fail 'usage: prepare ROOT-MOUNT BOOTSTRAP-TAR [SYSTEM]'
bundle=`{basename -d $0}
rootMount=$1
. $bundle/check-root.rc || fail 'cannot check published root'
test -r $2 || fail 'cannot read bootstrap archive'
if(test -e $node) fail 'machine state already exists:' $node
system=()
if(~ $#* 3) {
  . $bundle/output.rc || fail 'cannot read output resolver'
  system=`{resolveOutput system $3}
  ~ $#system 1 || fail 'cannot resolve initial system'
  test -f $system/system && ~ `{cat $system/system} nix9-system-2 || fail 'expected a built nix9 system'
  test -f $system/machine-id && ~ `{cat $system/machine-id} $machineId || fail 'system belongs to another machine'
  boot=$bundle
  if(test -f $bundle/path) boot=$bundle/path
  boot=`{resolveOutput boot $boot}
  ~ $#boot 1 || fail 'cannot resolve boot artifact'
  closure=`{nix-store --query --requisites $system $boot && echo nix9-closure-ready}
  ~ $#closure 0 && fail 'cannot query initial closure'
  ~ $closure($#closure) nix9-closure-ready || fail 'cannot query initial closure'
  objects=()
  for(item in $closure)
    if(! ~ $item nix9-closure-ready) objects=($objects $item)
}
mkdir -p $node || fail 'cannot create machine directory'
chmod 755 $node || fail 'cannot set machine directory permissions'
@{ cd $node && tar x } < $2 || fail 'cannot unpack bootstrap'
for(directory in rc/bin rc/lib adm service sys/log sys/lib/tls/webfs cfg/nix9 tmp usr/glenda usr/local/nix/store usr/local/nix/state usr/local/nix/log)
  mkdir -p $node/$directory || fail 'cannot create machine directory:' $directory
chmod 700 $node/adm || fail 'cannot protect runtime keys'
. $bundle/copy-tree.rc || fail 'cannot read tree copier'
copyTree $base/usr/glenda $node/usr/glenda 755 || fail 'cannot seed the initial home directory'
mkdir -p -m 755 $node/usr/glenda/bin/rc $node/usr/glenda/bin/amd64 ||
  fail 'cannot prepare native user command directories'
if(test -f $base/sys/lib/tls/webfs/revoked) {
  cp $base/sys/lib/tls/webfs/revoked $node/sys/lib/tls/webfs/revoked &&
  chmod u+w $node/sys/lib/tls/webfs/revoked || fail 'cannot seed TLS revocations'
}
for(hook in rc/bin/cpurc.local rc/bin/termrc.local rc/lib/rcmain.local) {
  for(file in $hook $hook^.nix9-original) {
    if(test -f $base/$file)
      cp $base/$file $node/$file || fail 'cannot copy startup hook:' $file
  }
}
# Initialize through the normal command, in a namespace using only this node's state.
@{
  rfork ne
  nix9local=()
  nix9machine=$machineId
  bind -c $node/usr/local/nix /usr/local/nix &&
  bind -c $node/usr/local/pkg /usr/local/pkg &&
  . /usr/local/pkg/nix9/activate &&
  nix9 init $machineId
} || fail 'cannot initialize machine identity'
if(~ $#system 1) {
  initial=$node/cfg/nix9/initial
  mkdir -m 700 $initial || fail 'cannot create initial installation directory'
  nix-store --export $objects > $initial/closure.partial || fail 'cannot export initial closure'
  mv $initial/closure.partial $initial/closure || fail 'cannot finish initial closure'
  echo $machineId > $initial/machine-id &&
  echo $system > $initial/system &&
  echo $boot > $initial/boot &&
  cp $bundle/finish $initial/finish || fail 'cannot stage initial selection'
  echo 'At the first CPU console, run: rc /cfg/nix9/initial/finish'
}
echo 'Prepared network-root machine:' $machineId

#!/bin/rc -e
rfork ne

fn fail {
  echo nix9: $* >[1=2]
  exit 'deployment target failed'
}
if(! ~ $#* 6) fail 'invalid target request'
input=$6
. $input/request.rc || fail 'cannot read target request'
action=$1
installation=$2
name=$3
identity=$4
system=$5
if(! ~ $action status status-health missing prepare ready select prepare-root prepare-boot root-ready select-root prepare-pxe pxe-ready select-pxe)
  fail 'invalid target action'
. /usr/local/pkg/nix9/activate || fail 'cannot activate target Nix'
path=($nix9/bin /$cputype/bin /rc/bin)
helperDirectory=`{basename -d $0}
if(! ~ $#nix9MachineId 1 || ! ~ $nix9MachineId $identity)
  fail $name 'machine identity differs from the inventory'
root=/usr/local/nix/state/gcroots/deployments/^$installation^/^$identity

fn readRoot {
  value=-
  if(test -e $1) {
    value=`{cat $1}
    if(! ~ $#value 1) fail 'invalid root:' $1
    if(! echo $value | awk 'NR == 1 && /^\/usr\/local\/nix\/store\/[a-zA-Z0-9+._?=-]+$/ {ok=1} END {exit !(ok && NR == 1)}')
      fail 'invalid root:' $1
  }
  status=''
}
if(~ $action status status-health) {
  readRoot $root
  echo $name prepared $value
  readRoot $nix9SystemRoot
  selected=$value
  readRoot $nix9SystemRoot^-boot
  booted=$value
  echo $name selected $selected
  echo $name booted $booted
  reboot=required
  if(~ $selected -) reboot=unselected
  if not if(~ $selected $booted) reboot=no
  if(~ $#bootArtifact 1) {
    . $helperDirectory/root-target.rc || fail 'cannot inspect root deployment'
    if(! ~ $rootReboot no) reboot=required
  }
  echo $name reboot $reboot
  if(~ $action status-health) {
    if(~ $booted - || ! test -f $booted/health) {
      echo $name health-result failed
      echo '  booted health checks unavailable; rebuild and reboot'
    }
    if not {
      /$cputype/bin/rc -e $booted/health $name || status=''
    }
  }
  exit ''
}

lock='#s/nix9-deploy-target-'^$identity
@{ status='' } > $lock || fail 'target deployment is locked:' $lock
rootWork=()
rootMounted=0
fn sigexit {
  result=$status
  if(~ $#rootWork 1) {
    if(~ $rootMounted 1) {
      if(unmount $rootWork/main) rootMounted=0
    }
    if(~ $rootMounted 0) {
      if(test -d $rootWork/main) rm $rootWork/main
      rm $rootWork
    }
  }
  rm $lock
  status=$result
}
if(~ $action prepare prepare-root prepare-boot prepare-pxe) {
  if(test -f $input/closure.export)
    nix-store --import < $input/closure.export > /dev/null || fail 'closure import failed'
}
switch($action) {
case missing
  # --print-invalid returns only unregistered paths, without trying to build.
  nix-store --check-validity --print-invalid `{cat $input/paths} || fail 'cannot inspect target store'
case prepare
  mkdir -p /usr/local/nix/state/gcroots/deployments/$installation
  nix-store --option substitute false --realise $system --add-root $root > /dev/null ||
    fail 'cannot retain the imported system'
  nix9 check $system || fail 'system preflight failed'
case ready select
  if(! test -r $root || ! ~ `{cat $root} $system) fail $name 'has not prepared the intended system'
  nix9 check $system || fail 'system preflight failed'
  if(~ $action select) nix9 select $system || fail 'system selection failed'
case prepare-root prepare-boot root-ready select-root
  . $helperDirectory/root-target.rc || fail 'root deployment failed'
case prepare-pxe pxe-ready select-pxe
  . $helperDirectory/pxe-target.rc || fail 'PXE deployment failed'
}
exit ''

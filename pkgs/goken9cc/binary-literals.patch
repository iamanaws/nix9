--- a/compilers/cck/lex.c
+++ b/compilers/cck/lex.c
@@ -849,6 +849,16 @@
 				yyerror("malformed hex constant");
 			goto ncu;
 		}
+	if(c == 'b' || c == 'B')
+		for(;;) {
+			*cp++ = c;
+			c = GETC();
+			if(c == '0' || c == '1')
+				continue;
+			if(cp == symb+2)
+				yyerror("malformed binary constant");
+			goto ncu;

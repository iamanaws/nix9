 	for(;;) {
@@ -1001,6 +1011,8 @@
 	c = *s;
 	if(c == 'x' || c == 'X')
 		goto hex;
+	if(c == 'b' || c == 'B')
+		goto bin;
 	while(c = *s++) {
 		if(c >= '0' || c <= '7')
 			nn = n*8 + c-'0';
@@ -1009,6 +1021,17 @@
 		if(n < 0 && nn >= 0)
 			goto bad;
 		n = nn;
+	}
+	goto out;
+
+bin:
+	s++;
+	while(c = *s++) {
+		if(c != '0' && c != '1')
+			goto bad;

fn nix9KeepPath {
	for(directory in $*) {
		if(~ $#nix9 0) echo $directory
		if not if(! ~ $directory $nix9/bin) echo $directory
	}
}
nix9Path=`{nix9KeepPath $path}
if(! ~ $#nix9EnvironmentActive 0)
	nix9BasePath=($nix9Next/bin `{nix9KeepPath $nix9BasePath})
path=($nix9Next/bin $nix9Path)
nix9=$nix9Next
nix9Next=()
nix9Path=()
fn nix9KeepPath
NIX_REMOTE='local?store=/usr/local/nix/store&state=/usr/local/nix/state&log=/usr/local/nix/log'
NIX_PATH='nix9='^$nix9/packages
NIX_CONF_DIR=$nix9
status=''
# Older system generations predate managed services. Drop our private overlay
# before their activation so an inherited daemon cannot keep a newer TLS policy.
if(~ $#nix9WebfsSystem 1 && test -r /usr/local/nix/state/gcroots/system &&
  ! test -f `{cat /usr/local/nix/state/gcroots/system}^/services/webfs.rc) {
  rfork ne && {
    nix9WebfsStop=1
    if(. $nix9WebfsSystem/services/webfs.rc) { nix9WebfsStop=(); status='' }
    if not { nix9WebfsStop=(); status='webfs activation failed' }
  }
}
if not status=''

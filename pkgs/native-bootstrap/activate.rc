. $nix9Next/packages/system/machine.rc && {
# Discard inherited activation state only when newns has removed the system's
# file bind. An ordinary refresh must still check ownership of managed webfs.
if(~ $#nix9System 1 && ! @{
	rfork e
	fn identity {
		/$cputype/bin/ls -qld $1 | /$cputype/bin/awk '{print $1 ":" $5 ":" $6}'
	}
	previous=`{identity $nix9System/files}
	mounted=`{identity /cfg/nix9/files}
	~ $#previous 1 && ~ $#mounted 1 && ~ $previous $mounted
}) {
	. $nix9Next/packages/system/reset.rc
	path=(/bin .)
	PATH=/bin
}
fn nix9KeepPath {
	for(directory in $*) {
		if(~ $#nix9 0) echo $directory
		if not if(! ~ $directory $nix9/bin) echo $directory
	}
}
fn nix9MakePATH {
	@{
		rfork e
		ifs=: { nix9PathParts=`{echo -n $1} }
		if(~ $#nix9PathParts 0) nix9PathParts=/bin
		echo -n $nix9Next/bin
		for(nix9Directory in `{nix9KeepPath $nix9PathParts}) echo -n :^$nix9Directory
		echo
	}
}
nix9Path=`{nix9KeepPath $path}
if(! ~ $#nix9EnvironmentActive 0) {
	nix9BasePath=($nix9Next/bin `{nix9KeepPath $nix9BasePath})
	nix9BasePATH=`{nix9MakePATH $nix9BasePATH}
}
path=($nix9Next/bin $nix9Path)
PATH=`{nix9MakePATH $PATH}
nix9=$nix9Next
nix9Next=()
nix9Path=()
fn nix9KeepPath
fn nix9MakePATH
NIX_REMOTE='local?store=/usr/local/nix/store&state=/usr/local/nix/state&log=/usr/local/nix/log'
NIX_PATH='nix9='^$nix9/packages
NIX_CONF_DIR=$nix9
status=''
}

 std::optional<std::string> getEnv(const std::string & key)
 {
+#ifdef __plan9__
+    // cc9 getenv drops empty values and trailing newlines. Preserve both.
+    if (key.empty() || key == "." || key == ".." || key.find_first_of("/=\0", 0, 3) != key.npos)
+        return {};
+    try {
+        auto value = readFile(std::filesystem::path("/env") / key);
+        if (auto nul = value.find('\0'); nul != value.npos) value.resize(nul);
+        return value;
+    } catch (const SysError & e) {
+        if (e.errNo != ENOENT) throw;
+        return {};
+    }
+#else
     char * value = getenv(key.c_str());
     if (!value)
         return {};
     return std::string(value);
+#endif
 }
 

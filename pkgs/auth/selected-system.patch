+/*
+ * The selected system is an administrator-approved immutable configuration.
+ * Unlike writable /cron/user tables, its directory uid is the store builder's,
+ * not the account named by the table. Only -s uses this separate trust model.
+ * Clear every old table on a generation change, including removed users/jobs.
+ */
+void
+readsystemjobs(void)
+{
+	char path[1024], root[512], *p;
+	Dir *d;
+	User *u;
+	int fd, i, n;
+
+	root[0] = 0;
+	fd = open(systemroot, OREAD);
+	if(fd >= 0){
+		n = read(fd, root, sizeof(root)-1);
+		close(fd);
+		if(n > 0){
+			root[n] = 0;
+			if(p = strchr(root, '\n'))
+				*p = 0;
+		}
+	}
+	if(strncmp(root, "/usr/local/nix/store/", 21) != 0
+	|| strchr(root+21, '/') != nil)
+		root[0] = 0;
+	if(selected != nil && strcmp(root, selected) == 0)
+		return;
+	for(i = 0; i < nuser; i++){
+		freejobs(users[i].jobs);
+		users[i].jobs = nil;
+	}
+	free(selected);
+	selected = strdup(root);
+	if(root[0] == 0)
+		return;
+	snprint(path, sizeof path, "%s/services/cron/tables", root);
+	fd = open(path, OREAD);
+	if(fd < 0)
+		return; /* Scheduler disabled in the selected generation. */
+	while((n = dirread(fd, &d)) > 0){
+		for(i = 0; i < n; i++){
+			if(d[i].qid.type & QTDIR)
+				continue;
+			u = newuser(d[i].name);
+			snprint(path, sizeof path, "%s/services/cron/tables/%s", root, d[i].name);
+			u->jobs = readjobs(path, u);
 		}
 		free(d);
 	}
